# Copy this file to `.env` and adjust values for your machine.
# Never commit the real `.env` file (it's in .gitignore).

# Where the persisted ChromaDB vector store lives (produced by the notebook's
# Section 2.6 Export step). Relative to the backend/ folder.
VECTOR_STORE_PATH=./data/vector_store
VECTOR_STORE_COLLECTION=cloudtask_kb

# Must match what the notebook used to build the vector store, or retrieval
# quality silently degrades (see Section 2.3 of rag_pipeline.ipynb).
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Local Ollama model + server URL.
LLM_MODEL=llama3.2
OLLAMA_HOST=http://localhost:11434

# Default number of chunks retrieved per query; the frontend/client can
# override this per-request within the 1-10 range enforced by the API.
DEFAULT_TOP_K=3

# Comma-separated list of origins allowed to call this API (CORS).
# Add your Streamlit/Gradio frontend's URL here.
ALLOWED_ORIGINS=http://localhost:8501,http://localhost:7860
